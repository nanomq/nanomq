# NanoMQ broker demo options
#
# An application-level Kconfig file replaces the top of the Zephyr tree
# (kconfig.cmake: KCONFIG_ROOT = <app>/Kconfig when it exists), so the
# whole Zephyr tree must be pulled back in explicitly.  See
# samples/basic/minimal/Kconfig for the same pattern.

config BROKER_LOG_DEBUG
	bool "Set NanoMQ log level to DEBUG"
	help
	  Bumps nanolib log level from the default WARN to DEBUG so the
	  MQTT session flow is visible on the console.  Disable for normal
	  runs (less noise, fewer cycles in log formatting).

config BROKER_REST_API
	bool "Enable the NanoMQ REST API (HTTP tcp:8081, Basic auth)"
	help
	  Sets conf http_server.enable / auth_type=BASIC plus the admin/public
	  credentials in main.c, so the broker serves /api/v4 over plain HTTP
	  behind Basic auth.

	  Basic over plain HTTP is base64, not encryption — TLS is compiled
	  out of the Zephyr NanoNNG.  Keep this off untrusted networks.

config BROKER_REST_USER
	string "REST API Basic-auth username"
	depends on BROKER_REST_API
	default ""
	help
	  Username for the REST API's Basic auth.  Deliberately no default:
	  the board serves this port to the whole LAN, so the API stays off
	  until a deployment supplies its own credentials.  Set both this and
	  BROKER_REST_PASS from local.conf (see local.conf.example).  The
	  published admin/public pair from etc/nanomq.conf is refused rather
	  than accepted.

config BROKER_REST_PASS
	string "REST API Basic-auth password"
	depends on BROKER_REST_API
	default ""
	help
	  Password matching BROKER_REST_USER.  Both must be set, and must not
	  be the published admin/public pair, for the listener to come up.

config BROKER_WEBHOOK
	bool "Enable the NanoMQ webhook forwarder (POST to BROKER_WEBHOOK_URL)"
	help
	  Sets conf web_hook.enable, an inproc hook channel (Zephyr has no IPC
	  transport) and two rules (MESSAGE_PUBLISH on "hook/#", CLIENT_CONNACK).
	  The receiver URL comes from BROKER_WEBHOOK_URL below; leave that empty
	  and the forwarder stays off.

config BROKER_WEBHOOK_URL
	string "Webhook receiver URL"
	depends on BROKER_WEBHOOK
	default ""
	help
	  Where the broker POSTs event JSON, e.g. "http://192.168.1.5:18080/".
	  Must be the LAN address of the machine running hook_receiver.py, and
	  reachable from the board.  Set it in local.conf (alongside the Wi-Fi
	  credentials) since it depends on your network:

	    CONFIG_BROKER_WEBHOOK=y
	    CONFIG_BROKER_WEBHOOK_URL="http://192.168.1.5:18080/"

config BROKER_WS
	bool "Enable the WebSocket listener (MQTT over RFC6455, tcp:8083)"
	help
	  Sets conf websocket.enable / websocket.url in main.c so the broker
	  also accepts MQTT over WebSocket on nmq-ws://0.0.0.0:8083/mqtt.
	  Requires the mqttws transport in the NanoNNG build (enabled by this
	  app's CMakeLists via NNG_TRANSPORT_MQTT_BROKER_WS=ON).  On the board
	  the listener is reached directly over Wi-Fi at the address DHCP
	  handed out — there is no SLIRP host forward here (that is the qemu
	  demo).  TLS is built out of the Zephyr NanoNNG, so WSS stays inert.

config BROKER_WIFI_SSID
	string "Wi-Fi SSID (STA mode)"
	depends on WIFI_ESP32
	default ""
	help
	  SSID of the 2.4 GHz access point the demo connects to.  Meant to be
	  set from a local, git-ignored conf file (see local.conf.example) so
	  real credentials never land in the tree.

config BROKER_WIFI_PSK
	string "Wi-Fi passphrase (STA mode; empty = open network)"
	depends on WIFI_ESP32
	default ""
	help
	  WPA2-PSK passphrase for BROKER_WIFI_SSID.  Empty selects an open
	  (unsecured) network.

source "Kconfig.zephyr"
