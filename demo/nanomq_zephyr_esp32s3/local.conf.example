# Local (untracked) Wi-Fi credentials for demo/nanomq_zephyr_esp32s3.
#
# Copy this file to local.conf next to prj.conf, fill in the real values
# and pass it to the build:
#
#   west build -b esp32s3_devkitc/esp32s3/procpu demo/nanomq_zephyr_esp32s3 \
#       -- -DEXTRA_CONF_FILE=local.conf
#
# local.conf is git-ignored so credentials stay out of the tree.

CONFIG_BROKER_WIFI_SSID=""
CONFIG_BROKER_WIFI_PSK=""

# REST API Basic-auth credentials.  prj.conf sets CONFIG_BROKER_REST_API=y,
# but the listener stays off until both of these are set to something other
# than the published admin/public pair -- so this is what turns the API on.
# The board serves tcp:8081 to the whole LAN, so pick real values:
CONFIG_BROKER_REST_USER=""
CONFIG_BROKER_REST_PASS=""
