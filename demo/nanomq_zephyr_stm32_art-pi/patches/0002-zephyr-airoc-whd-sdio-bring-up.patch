diff --git a/drivers/wifi/infineon/airoc_whd_hal_sdio.c b/drivers/wifi/infineon/airoc_whd_hal_sdio.c
index cf9f254be42..dcf6a661351 100644
--- a/drivers/wifi/infineon/airoc_whd_hal_sdio.c
+++ b/drivers/wifi/infineon/airoc_whd_hal_sdio.c
@@ -11,6 +11,8 @@
 #include <bus_protocols/whd_bus_sdio_protocol.h>
 #include <bus_protocols/whd_bus.h>
 #include <bus_protocols/whd_sdio.h>
+#include <whd_wifi_api.h>
+#include <whd_thread.h>
 #include <zephyr/logging/log.h>
 #include <zephyr/sd/sd.h>
 
@@ -32,6 +34,36 @@ static whd_init_config_t init_config_default = {.thread_stack_size = CY_WIFI_THR
 							(uint32_t)CY_WIFI_THREAD_PRIORITY,
 						.country = CY_WIFI_COUNTRY};
 
+#if defined(CONFIG_AIROC_WIFI_WHD_POKE)
+/*
+ * Boards whose SDIO Wi-Fi chip never asserts the in-band card interrupt.
+ *
+ * WHD's thread only polls for received frames when it is woken with the
+ * "bus interrupt" flag set (whd_bus_sdio_use_status_report_scheme() returns
+ * WHD_FALSE for this transport), so it depends entirely on the SDIO card
+ * interrupt on DAT1.  On the ART-Pi's AP6212 that interrupt is never
+ * asserted -- the controller's SDMMC_STA.SDIOIT stays clear even though
+ * SDMMC_MASK.SDIOITIE is set and CCCR INTEN has function 2 enabled -- so
+ * the first WLAN ioctl (WLC_GET_VAR "cap") is written to function 2 and
+ * then times out without the reply ever being read.
+ *
+ * Poking the thread from a timer gives it the same wake-up the interrupt
+ * would have, and its poll then picks up whatever the chip has queued.
+ * See demo/nanomq_zephyr_stm32_art-pi, docs/en_US/port-to-art-pi.md (the
+ * "no in-band SDIO card interrupt" section), for the measurements.
+ */
+static struct k_timer whd_poke_timer;
+
+static void whd_poke_expiry(struct k_timer *timer)
+{
+	whd_driver_t drv = k_timer_user_data_get(timer);
+
+	if (drv != NULL) {
+		whd_thread_notify_irq(drv);
+	}
+}
+#endif /* CONFIG_AIROC_WIFI_WHD_POKE */
+
 /******************************************************
  *                 Function
  ******************************************************/
@@ -113,10 +145,44 @@ int airoc_wifi_init_primary(const struct device *dev, whd_interface_t *interface
 					      (whd_sdio_t)&data->card);
 
 		if (whd_ret == CY_RSLT_SUCCESS) {
+#if defined(CONFIG_AIROC_WIFI_WHD_POKE)
+			/* See whd_poke_timer: stand in for the card interrupt. */
+			k_timer_init(&whd_poke_timer, whd_poke_expiry, NULL);
+			k_timer_user_data_set(&whd_poke_timer, data->whd_drv);
+			k_timer_start(&whd_poke_timer, K_MSEC(20), K_MSEC(20));
+#endif
 			whd_ret = whd_wifi_on(data->whd_drv, interface);
 		}
 
+#if defined(CONFIG_AIROC_WIFI_DISABLE_POWERSAVE)
+		if (whd_ret == CY_RSLT_SUCCESS) {
+			/*
+			 * Keep the chip awake.
+			 *
+			 * With its power save enabled the device drops into the
+			 * KSO sleep, and the *first* wake-up write to
+			 * SDIO_SLEEP_CSR (0x1001F) is deliberately not answered
+			 * -- WHD's own comment says so and it ignores the error
+			 * -- while a host controller reports every unanswered
+			 * command as a command-response timeout.  On the ART-Pi
+			 * that starts ~50 s after association (when the chip's
+			 * PM2 kicks in) and buries the console in
+			 * "sdhc_stm32: Command response timeout" at ~300/s while
+			 * the data path is fine (measured: CMD53 transfers never
+			 * fail, only the CMD52 wake writes do).
+			 */
+			whd_result_t ps_ret = whd_wifi_disable_powersave(*interface);
+
+			LOG_INF("Wi-Fi power save %s",
+				(ps_ret == WHD_SUCCESS) ? "disabled" : "not disabled");
+		}
+#endif /* CONFIG_AIROC_WIFI_DISABLE_POWERSAVE */
+
 		if (whd_ret != CY_RSLT_SUCCESS) {
+#if defined(CONFIG_AIROC_WIFI_WHD_POKE)
+			/* Do not keep poking a thread we are about to tear down. */
+			k_timer_stop(&whd_poke_timer);
+#endif
 			whd_deinit(*interface);
 			return -ENODEV;
 		}
@@ -155,6 +221,7 @@ whd_result_t whd_bus_sdio_cmd52(whd_driver_t whd_driver, whd_bus_transfer_direct
 	} else {
 		ret = sdio_read_byte(func, address, response);
 	}
+
 	WHD_BUS_STATS_CONDITIONAL_INCREMENT_VARIABLE(whd_driver->bus_priv, (ret != WHD_SUCCESS),
 						     cmd52_fail);
 
