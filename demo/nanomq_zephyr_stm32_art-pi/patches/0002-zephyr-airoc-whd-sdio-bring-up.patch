@@ -125,6 +125,42 @@ if(CONFIG_CYW43438 AND NOT CONFIG_AIROC_WIFI_CUSTOM)
   endif()
 endif()
 
+# CYW43438 clm/nvram
+#
+# Upstream wires only the firmware for this part.  The ART-Pi's AP6212 is a
+# plain CYW43438 and the WHD blob manifest ships this chip's CLM and NVRAM for
+# the AW-CU427-P module, so mirror the per-module blocks above.
+if(CONFIG_CYW43438 AND NOT CONFIG_AIROC_WIFI_CUSTOM)
+  # clm
+  if(CONFIG_AIROC_WLAN_MFG_FIRMWARE)
+    set(CLM_IMAGE_NAME ${hal_blobs_dir}/clm/COMPONENT_43438/COMPONENT_AW-CU427-P/43438A1-mfgtest.clm_blob)
+  else()
+    set(CLM_IMAGE_NAME ${hal_blobs_dir}/clm/COMPONENT_43438/COMPONENT_AW-CU427-P/43438A1.clm_blob)
+  endif()
+  # nvram
+  set(NVRAM_IMAGE_NAME ${hal_wifi_dir_resources}/nvram/COMPONENT_43438/COMPONENT_AW-CU427-P/cyw943438_aw-cu427.txt)
+endif()
+
+# The only CLM published for the 43438 is the AW-CU427-P module's, and the
+# ART-Pi's AP6212 rejects it at CLM download time ("CLM blob file not found or
+# corrupted" -> WHD init fails with -ENODEV).  Building WHD without a CLM
+# resource makes whd_process_clm_data() log "No loading CLM blob file" and
+# carry on, which is enough to bring the link up; regulatory/RF calibration
+# data is absent until the board's own CLM is wired in.  Opt in with
+# CONFIG_AIROC_WIFI_NO_CLM (see the demo's wifi.conf).
+if(CONFIG_AIROC_WIFI_NO_CLM)
+  zephyr_compile_definitions(NO_CLM_BLOB_FILE)
+endif()
+
+# WHD's verbose debug also compiles in the post-download verification
+# (whd_bus_sdio_verify_resource(), which reads every downloaded block back and
+# memcmp's it, logging "Downloaded image is corrupted" on a mismatch).  That
+# is the only in-tree way to tell a broken SDIO bulk write from a firmware
+# that the chip simply refuses to boot, so it is exposed as an option.
+if(CONFIG_AIROC_WIFI_WHD_DEBUG)
+  zephyr_compile_definitions(WPRINT_ENABLE_WHD_DEBUG)
+endif()
+
 # CYW43439 firmware
 if(CONFIG_CYW43439 AND NOT CONFIG_AIROC_WIFI_CUSTOM)
   if(CONFIG_AIROC_WLAN_MFG_FIRMWARE)
