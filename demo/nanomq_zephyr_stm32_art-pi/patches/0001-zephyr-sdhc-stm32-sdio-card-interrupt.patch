+/*
+ * SDIO card interrupt support.
+ *
+ * Function drivers (the Infineon AIROC Wi-Fi stack among them) wait for the
+ * card's asynchronous events and ioctl responses; without this the SDMMC
+ * controller never forwards the DAT1 interrupt and those waits time out.
+ */
+static int sdhc_stm32_enable_interrupt(const struct device *dev, sdhc_interrupt_cb_t callback,
+				       int sources, void *user_data)
+{
+	struct sdhc_stm32_data *dev_data = dev->data;
+	SDMMC_TypeDef *instance = sdhc_stm32_get_instance(dev);
+
+	/* Only the SDIO card interrupt is wired up. */
+	if (sources != SDHC_INT_SDIO) {
+		return -ENOTSUP;
+	}
+	if (callback == NULL) {
+		return -EINVAL;
+	}
+
+	dev_data->sdio_cb = callback;
+	dev_data->sdio_cb_user_data = user_data;
+
+	/* Unmask "SDIO interrupt received" (SDMMC_MASK.SDIOITIE).
+	 *
+	 * This is enough for the API to work, but note for STM32 + CYW43xxx
+	 * boards: DCTRL.SDIOEN (the peripheral's "SD I/O mode") is deliberately
+	 * *not* set here.  It was tried on the ART-Pi's AP6212 and is not the
+	 * missing piece — SDMMC_STA.SDIOIT still never latched, and enabling it
+	 * made 4-bit transfers fail with "Command response timeout".  That chip
+	 * does not drive DAT1 on this board at all, so a function driver that
+	 * waits on the card interrupt alone (WHD does) has to poll instead; see
+	 * demo/nanomq_zephyr_stm32_art-pi, docs/en_US/port-to-art-pi.md.
+	 */
+	instance->MASK |= SDMMC_MASK_SDIOITIE;
+
+	return 0;
+}
+
+static int sdhc_stm32_disable_interrupt(const struct device *dev, int sources)
+{
+	struct sdhc_stm32_data *dev_data = dev->data;
+	SDMMC_TypeDef *instance = sdhc_stm32_get_instance(dev);
+
+	if (sources != SDHC_INT_SDIO) {
+		return -ENOTSUP;
+	}
+
+	instance->MASK &= ~SDMMC_MASK_SDIOITIE;
+	dev_data->sdio_cb = NULL;
+	dev_data->sdio_cb_user_data = NULL;
+
+	return 0;
+}
+
 static DEVICE_API(sdhc, sdhc_stm32_api) = {
 	.request = sdhc_stm32_request,
 	.set_io = sdhc_stm32_set_io,
@@ -1926,6 +2015,8 @@ static DEVICE_API(sdhc, sdhc_stm32_api) = {
 	.get_card_present = sdhc_stm32_get_card_present,
 	.card_busy = sdhc_stm32_card_busy,
 	.reset = sdhc_stm32_reset,
+	.enable_interrupt = sdhc_stm32_enable_interrupt,
+	.disable_interrupt = sdhc_stm32_disable_interrupt,
 };
 
 #ifdef CONFIG_PM_DEVICE
